node_modules/
dist/
config.json
config.*.json

# Google Play service-account keys. They live in ~/.play-keys/ and are passed
# to tools/play-upload.mjs by path — this only stops a stray copy being added.
*-service-account*.json
play-key*.json
*iam.gserviceaccount.com*.json
logs/*.json
logs/*.png
.DS_Store
.playwright-mcp/

# Native build output. None of it is tracked; this stops it being added by
# accident and keeps `git status` readable while a store build is running.
field-app/capacitor/android/build/
field-app/capacitor/android/.gradle/
field-app/capacitor/android/app/build/
field-app/capacitor/ios/App/build/
field-app/capacitor/ios/App/Pods/
DerivedData/
*.ipa
*.dSYM.zip

# BSI's price list. Part numbers and descriptions ship to the phone via
# field-app/js/parts-catalog.js; materials and labor are Batavia's pricing and
# do not belong in a git history. Regenerate with tools/bsi-products.mjs.
bsi-products.json
bsi-form-dump.json
