<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core NFC. The plugin uses NFCNDEFReaderSession, which will not start
	     without this. It also requires the "Near Field Communication Tag
	     Reading" capability enabled on the App ID in the developer portal —
	     that part cannot be done from the repo. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<!-- TAG, not NDEF. The iOS 26 SDK rejects NDEF at App Store validation:
		     "NDEF is disallowed ... TAG is missing in the entitlement" (409
		     STATE_ERROR.VALIDATION_ERROR, hit on the build 3 upload
		     2026-08-24). TAG is the superset and covers NDEF reads. -->
		<string>TAG</string>
	</array>
</dict>
</plist>
