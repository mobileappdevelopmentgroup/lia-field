<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core NFC. The plugin uses NFCNDEFReaderSession, which will not start
	     without this. It also requires the "Near Field Communication Tag
	     Reading" capability enabled on the App ID in the developer portal —
	     that part cannot be done from the repo. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
	</array>
</dict>
</plist>
