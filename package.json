{
  "name": "lia-ladder-import-assistant",
  "version": "1.8.2",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "tsx src/main.ts",
    "codegen": "playwright codegen https://bsiwebapp.com",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/core/*.test.ts",
    "test:field": "node field-app/test/device-cache.test.mjs && node field-app/test/modules.test.mjs && node field-app/test/fp-types.test.mjs && node field-app/test/fp-capture.test.mjs && node field-app/test/sync.test.mjs && node field-app/test/boot.test.mjs && node field-app/test/nfc.test.mjs && node field-app/test/tag-link.test.mjs && node field-app/test/tag-write.test.mjs && node field-app/test/help.test.mjs && node field-app/test/assignments.test.mjs && node field-app/test/fp-batch.test.mjs && node field-app/test/farewell.test.mjs",
    "schema": "./supabase/tools/schema-snapshot.sh",
    "schema:check": "./supabase/tools/schema-snapshot.sh --check",
    "test:sql": "./supabase/test/run.sh",
    "play:upload": "node tools/play-upload.mjs",
    "capture:help": "node field-app/tools/capture-help-shots.mjs",
    "sync:www": "node field-app/capacitor/scripts/sync-www.mjs",
    "check:www": "node field-app/capacitor/scripts/sync-www.mjs --check",
    "test:desktop": "node electron/test/catalog.test.mjs && node electron/test/merge-screen.test.mjs && node electron/test/support-inbox.test.mjs && node electron/test/cert-views.test.mjs && node electron/test/fp-records.test.mjs && node electron/test/fp-push.test.mjs && node electron/test/job-board.test.mjs && node electron/test/act-as.test.mjs && node electron/test/onboarding.test.mjs",
    "build:runner": "esbuild src/electron-runner.ts --bundle --platform=node --format=cjs --outfile=dist/electron-runner.cjs --external:playwright --external:playwright-core",
    "build:core": "esbuild src/core/index.ts --bundle --platform=node --format=cjs --outfile=dist/lia-core.cjs",
    "build:all": "npm run build:runner && npm run build:core",
    "electron:dev": "npm run build:all && electron .",
    "electron:dev:staging": "npm run build:all && LIA_ENV=staging electron .",
    "electron:build": "npm run build:all && electron-builder --mac dmg",
    "electron:build:win": "npm run build:all && electron-builder --win nsis",
    "electron:build:dir": "npm run build:all && electron-builder --mac dir"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.1",
    "@types/papaparse": "^5.3.14",
    "cli-table3": "^0.6.5",
    "papaparse": "^5.4.1",
    "playwright": "^1.48.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "build": {
    "appId": "com.batavia.lia",
    "productName": "Lia",
    "copyright": "Copyright \u00a9 2026 Batavia",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Lia",
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lia"
    },
    "files": [
      "electron/**",
      "dist/electron-runner.cjs",
      "dist/lia-core.cjs",
      "node_modules/**",
      "!node_modules/.cache/**"
    ],
    "extraResources": [
      {
        "from": "dist/electron-runner.cjs",
        "to": "electron-runner.cjs"
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ]
  }
}
